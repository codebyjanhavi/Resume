# Python environments, bytecode, and test caches
venv/
**/__pycache__/
*.py[cod]
.pytest_cache/

# Local configuration and secrets; keep example templates
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
